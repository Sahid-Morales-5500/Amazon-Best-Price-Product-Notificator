# Ejemplo de como debe ser las variables de conexion de la DB.
# Copia el archivo en un .env que sea ignorado por Github y pon los datos realaes de la DB ahi

# Esta es la informacion que pasaras al .env que a su vez pasaras al archivo database.py
DB_HOST=localhost
DB_PORT=5432
DB_USER=tu_usuario_aqui
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=Notificator